# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Environment / secrets ----
.env
.env.*

# ---- Data ----
# Keep folder structure, ignore actual data files (can be large / shouldn't be versioned)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- Model artifacts ----
*.pkl
*.joblib
*.h5
models/*
!models/.gitkeep

# ---- Reports / generated output ----
reports/figures/*
!reports/figures/.gitkeep

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Logs ----
*.log